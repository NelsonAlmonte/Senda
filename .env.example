# Configuracion publica: estos valores se incorporan al cliente web.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-restricted-api-key

# Cuenta ADMIN ficticia usada exclusivamente por el simulador Node en desarrollo.
SENDA_SIMULATOR_EMAIL=simulator-admin@example.test
SENDA_SIMULATOR_PASSWORD=replace-with-development-password

# Nunca agregues service_role, contrasenas de base de datos, claves VAPID
# privadas ni secretos de simulacion a variables PUBLIC_*.
