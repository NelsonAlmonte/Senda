{
	"name": "senda",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:simulator": "node --test simulator/simulator-client.test.mjs",
		"generate:pwa-assets": "pwa-assets-generator --preset minimal-2023 static/pwa-source.svg",
		"generate:vapid-keys": "node scripts/generate-vapid-keys.mjs",
		"simulate:location": "node --env-file=.env simulator/send-location.mjs",
		"simulate:route": "node --env-file=.env simulator/play-route.mjs"
	},
	"dependencies": {
		"@googlemaps/js-api-loader": "2.1.3",
		"@supabase/ssr": "0.12.7",
		"@supabase/supabase-js": "2.118.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-netlify": "7.0.1",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.10.0",
		"@vite-pwa/assets-generator": "1.0.4",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vite-plugin-pwa": "1.3.0",
		"workbox-precaching": "7.4.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
