# Copia estos valores desde el .env local; no confirmes supabase/functions/.env.
PUBLIC_VAPID_PUBLIC_KEY=your-url-safe-vapid-public-key
SENDA_VAPID_PRIVATE_KEY=your-url-safe-vapid-private-key
SENDA_VAPID_SUBJECT=mailto:alerts@example.com
SENDA_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Secreto compartido con Traccar (cabecera x-senda-ingest-secret o Authorization: Bearer).
# Debe tener al menos 32 caracteres y ser distinto de SENDA_WEBHOOK_SECRET.
SENDA_INGEST_SECRET=replace-with-at-least-32-random-characters
